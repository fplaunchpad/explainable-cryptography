import ExplainableCrypto.Helios.Model
import ExplainableCrypto.Testing.Plausible

/-!
Executable refutation campaigns. Outcomes are inspected explicitly: unexpected
failure, success of a known-broken claim, and `gaveUp` all fail the build.
Finite cases are generated by construction, without discarded premises.
-/
namespace ExplainableCrypto.Helios

def generatedVote (n : Nat) : Vote :=
  match n % 3 with | 0 => .x | 1 => .y | _ => .abstain

def generatedPolicy (n : Nat) : Policy :=
  match n % 3 with | 0 => .original | 1 => .wholeBallot | _ => .components

def generatedRecipe (n : Nat) (target : Bool) : Recipe :=
  match n % 4 with
  | 0 => .fresh (generatedVote (n / 4))
  | 1 => .replay target
  | 2 => .permute target
  | _ => .malformed

open ExplainableCrypto.Testing

-- First establish that the harness can refute a known false security claim.
#eval campaign "original privacy negative control"
  (∀ w : Bool, xCountIs 2 (run .original w (.replay false)) =
    xCountIs 2 (run .original (!w) (.replay false)))
  1 true

#eval do
  for seed in [1, 7, 42] do
    campaign "permutation validity" (∀ n : Nat, ∀ target : Bool,
      let b := (generatedRecipe n target).submit publicBoard
      valid b.swap = valid b) seed
    campaign "fresh ballots remain live" (∀ n : Nat,
      let r := Recipe.fresh (generatedVote n)
      check (generatedPolicy (n / 3)) [publicBoard.alice, publicBoard.bob]
        (r.submit publicBoard) = none) seed
    campaign "weeding blocks selected attacks" (∀ w target : Bool, ∀ permute : Bool,
      (run .components w (if permute then .permute target else .replay target)).outcome =
        Outcome.rejected .reusedCiphertext) seed

end ExplainableCrypto.Helios
